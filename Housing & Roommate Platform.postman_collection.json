        {
          "name": "credential login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ensure the request was successful\r\nif (pm.response.code === 200) {\r\n    const responseData = pm.response.json();\r\n    \r\n    // Safely extract the token based on your response structure\r\n    const token = responseData?.data?.accessToken || responseData?.accessToken;\r\n    \r\n    if (token) {\r\n        // Automatically save/update the variable in your collection\r\n        pm.collectionVariables.set(\"accessToken\", token);\r\n        console.log(\"✅ Access token saved automatically to collection variable!\");\r\n    } else {\r\n        console.warn(\"⚠️ Login succeeded, but no accessToken was found in the response body.\");\r\n    }\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "\r\n{ // Owner\r\n    \"email\": \"testerowner@gmail.com\", \r\n    \"password\": \"Tester@owner12345\"\r\n}\r\n\r\n// { // Admin\r\n//     \"email\": \"testeradmin@gmail.com\", \r\n//     \"password\": \"Tester@admin12345\"\r\n// }\r\n\r\n\r\n// { // Customer\r\n//     \"email\": \"tester.tenant@gmail.com\", \r\n//     \"password\": \"Tester@subscribercustomer12345\"\r\n// }\r\n",
