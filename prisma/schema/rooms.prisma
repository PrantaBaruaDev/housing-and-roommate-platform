
model Rooms {
  id                  String               @id @default(uuid())
  propertyId          String
  roomNumber          String
  rentAmount          Decimal              @db.Decimal(10, 2)

   // --- 🔄 Dynamic Structural Capacity & Pricing Fields ---
  bookingMode       BookingMode       @default(BOOK_BY_ROOM)
  maxCapacity       Int               @default(1) // Safety ceiling (e.g., 2 slots for a double room)
  isAvailable         Boolean              @default(true)

  isDeleted           Boolean              @default(false)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  applications        Application[]
  viewingRequests     RoomViewingRequest[]
  maintenanceRequests MaintenanceRequest[]
//   chatThreads         ChatThread[]

  occupants    RoomOccupant[]   

  @@index([isAvailable, rentAmount, isDeleted])
  @@map("rooms")
}