model Rooms {
  id                  String               @id @default(uuid())
  propertyId          String
  flatId              String

  roomNumber          String
  rentAmount          Decimal              @db.Decimal(10, 2)
  bookingMode       BookingMode       @default(BOOK_BY_ROOM)
  maxCapacity       Int               @default(1) 
  availableCapacity Int               @default(1) // this capacity will be same as maxCapacity but when the user room occupant success fully then -1 deduct

  isAvailable         Boolean              @default(true)
  isDeleted           Boolean              @default(false)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  flats               Flats                @relation(fields: [flatId], references: [id], onDelete: Cascade)
  applications        Application[]
  viewingRequests     RoomViewingRequest[]
  occupants           RoomOccupant[] 

  @@index([isAvailable, rentAmount, isDeleted])
  @@map("rooms")
}