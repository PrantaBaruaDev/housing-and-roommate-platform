model Users {
  id                 String     @id @default(uuid())
  name               String
  email              String
  password           String
  googleId          String?     @unique
  authProvider      AuthProvider @default(CREDENTIAL)
  emailVerified      Boolean    @default(false)
  role               Role       @default(TENANT)
  status             UserStatus @default(ACTIVE)
  needPasswordChange Boolean    @default(false)
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  profiles      Profiles?
  payments      Payments[]
  notification  Notification[]

  properties         Property[]        // Available for OWNER role
  roomOccupant       RoomOccupant[]        // Available for OWNER role
  applications       Application[]     // Available for CUSTOMER (Tenant) role
  // sentMessages       Message[]         // For in-app chat engine
  auditLogs          AuditLog[]        // Actions tracked under security rule loops
  viewingRequests    RoomViewingRequest[]  // Tenant side requests
  maintenanceRequest MaintenanceRequest[]

  @@unique([email])
  @@map("users")
}
