model Application {
  id                String            @id @default(uuid())
  roomId            String
  tenantId          String
  status            ApplicationStatus @default(PENDING)
  moveInDate        DateTime

  isPrivateLease    Boolean           @default(false) 
  agreedRentAmount  Decimal           @db.Decimal(10, 2) 

  rentalDocumentUrl String?           // Cloudinary URL for signed lease contracts
  ownerFeedback     String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  room              Rooms             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant            Users             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          Payments[]
  roomOccupant      RoomOccupant?

  @@unique([roomId, tenantId])
  @@map("applications")
}